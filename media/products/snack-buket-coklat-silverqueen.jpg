  $(".mega-menu__link.has-sub").click(function(e){
    e.preventDefault()
    const t = $(this)
    const s = t.next("ul")
     $('.list-unstyled').hide();
    if($(e.target).is('.active')){
        console.log('1')
         $(this).removeClass('active');
     } else {
        console.log('2')
         $(".mega-menu__link.has-sub").removeClass('active').filter(this).addClass('active');
         s.show()
     }
  })
</script>

