  /* Responsive Design */
  @media (max-width: 768px) {
    .image-editor-popup {
      padding: 10px;
    }
    
    .image-editor-modal {
      max-width: calc(100vw - 20px);
      max-height: calc(100vh - 20px);
      width: 100%;
      height: auto;
      min-height: 80vh;
    }

    .image-editor-content {
      flex-direction: column;
    }

    .image-editor-controls {
