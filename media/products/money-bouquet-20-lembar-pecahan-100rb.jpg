			    <script>
    (function () {
        'use strict';

        function closeFkCart() {
            // Exact selector confirmed from DevTools
            const closeLink = document.querySelector('.fkcart-shopping-link.fkcart-modal-close, .fkcart-modal-close');
            if ( closeLink ) { closeLink.click(); return; }

            // Fallback: close button in header
            const closeIcon = document.querySelector('.fkcart-modal-close, .fkcart-icon-close');
            if ( closeIcon ) closeIcon.click();
        }

        function fixGoKwikZIndex() {
            const gk = document.getElementById('gokwik-modal-wrapper');
            if ( gk ) gk.style.zIndex = '999999';
        }

        // Intercept on the exact checkout button ID confirmed from DevTools
        document.addEventListener('click', function (e) {
            const btn = e.target.closest('#fkcart-checkout-button, .gc-button-replaced, .fkcart-checkout-btn');
            if ( ! btn ) return;
            setTimeout(function () {
                fixGoKwikZIndex();
                closeFkCart();
            }, 200);
        }, true);

    })();
    </script>
    	</body>
