        justify-content: center;
        flex-shrink: 0;
        transition: transform 0.3s;
        box-shadow: 0 1px 4px rgba(0,0,0,0.08);
    }

    .cpd-chevron svg {
        width: 14px;
        height: 14px;
        stroke: #9b1a4b;
