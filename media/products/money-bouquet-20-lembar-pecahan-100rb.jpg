            <style type="text/css">
                .smooth-back-to-top-button {
                    bottom: 30px;
                    height: 46px;
                    width: 46px;
                    border-radius: 46px;
                    background-color: #f5c9c9;
                    box-shadow: inset 0 0 0 2px #cccccc;
                }

                .smooth-back-to-top-button.btn-left-side {
                    left: 30px;
                }

                .smooth-back-to-top-button.btn-right-side {
                    right: 30px;
                }

				.smooth-back-to-top-button.btn-center {
					inset-inline: 0;
					margin-inline: auto;
				}

                .smooth-back-to-top-button::after {
                    height: 100%;
                    color: #1f2029;
                    font-size: 24px;
                    content: '\e911';
                    line-height: normal;
                    position: relative;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .smooth-back-to-top-button:hover::after {
                    color: #1f2029;
                }

                .smooth-back-to-top-button svg.progress-circle path,
                .smooth-back-to-top-button svg.progress-circle rect {
                    stroke: #1f2029;
                    stroke-width: 4px;
                    z-index: 5;
                }

                
                
                
                
            </style>

			    
    <script type="text/javascript">
        var ajaxurl = 'https://gulmahal.in/wp-admin/admin-ajax.php';
    </script>
    <style>
    #pincheck_wrapper, .pincheck_wrapper, #inext_wpc_wrapper { display: none !important; }
    .woocommerce-variation-add-to-cart .quantity,
    .woocommerce-variation-add-to-cart .single_add_to_cart_button,
    form.cart .quantity,
    form.cart .single_add_to_cart_button { display: none !important; }

    /* Show variation price on ALL devices */
    .woocommerce-variation.single_variation { display: block !important; }
    .woocommerce-variation-price { display: block !important; }
    .woocommerce-variation-price .price,
    .woocommerce-variation-price .price span,
    .woocommerce-variation-price ins,
    .woocommerce-variation-price ins span {
        display: inline !important;
        visibility: visible !important;
        opacity: 1 !important;
        font-size: 20px !important;
        font-weight: 700 !important;
        color: #9b1a4b !important;
    }
    .woocommerce-variation-availability { display: none !important; }

    /* ── Pincode ─────────────────────────────────────────────── */
    #custom-pincode-section { margin: 20px 0 14px; }
    #custom-pincode-section .pin-label { font-size: 15px; font-weight: 700; color: #111; margin-bottom: 10px; display: block; }
    .custom-pin-input-wrap { display: flex; align-items: center; border: 1.5px dashed #ccc; border-radius: 50px; padding: 6px 6px 6px 14px; background: #fff; max-width: 340px; gap: 8px; }
    .custom-pin-input-wrap .pin-icon { display: flex; align-items: center; flex-shrink: 0; }
    .custom-pin-input-wrap .pin-icon svg { width: 18px; height: 18px; fill: #9b1a4b; }
    #custom_pin_code { flex: 1; border: none; outline: none; font-size: 16px !important; color: #555; background: transparent; min-width: 0; }
    #custom_pin_code::placeholder { color: #aaa; }
    #custom_check_pin { padding: 0 18px; height: 36px; border-radius: 50px; background: #22c55e; border: none; cursor: pointer; font-size: 13px; font-weight: 600; color: #fff; flex-shrink: 0; transition: background 0.2s; white-space: nowrap; }
    #custom_check_pin:hover { background: #16a34a; }
    #custom_check_pin.loading { opacity: 0.6; pointer-events: none; }
    #custom_pin_result { margin-top: 8px; font-size: 13px; font-weight: 500; min-height: 18px; padding-left: 4px; }
    #custom_pin_result.success { color: #16a34a; }
    #custom_pin_result.error { color: #dc2626; }

    /* ── Order Note ──────────────────────────────────────────── */
    #custom-order-note { margin: 16px 0 0; }
    #custom-order-note label { font-size: 14px; font-weight: 600; color: #444; display: block; margin-bottom: 6px; }
    #custom-order-note label span { font-size: 12px; font-weight: 400; color: #999; margin-left: 6px; }
    #custom_order_note_input { width: 100%; min-height: 80px; padding: 10px 14px; border: 1.5px solid #e5e7eb !important; border-radius: 12px; font-size: 16px !important; color: #444; resize: vertical; outline: none; background: #fff !important; box-sizing: border-box; font-family: inherit; transition: border-color 0.2s; }
    #custom_order_note_input:focus { border-color: #9b1a4b !important; }
    #custom_order_note_input::placeholder { color: #bbb; }

    /* ── Cart row ─────────────────────────────────────────────── */
    #custom-cart-row { display: flex; align-items: center; gap: 12px; margin-top: 16px; flex-wrap: nowrap; }
    .custom-qty-wrap { display: flex; align-items: center; border: 1.5px solid #ccc; border-radius: 50px; overflow: hidden; height: 48px; user-select: none; flex-shrink: 0; }
    .custom-qty-wrap button { width: 40px; height: 48px; background: transparent; border: none; cursor: pointer; font-size: 20px; color: #333; display: flex; align-items: center; justify-content: center; transition: background 0.15s; }
    .custom-qty-wrap button:hover { background: #f3f4f6; }
    #custom_qty_display { min-width: 36px; text-align: center; font-size: 15px; font-weight: 600; color: #111; }
    #custom_add_to_cart_btn { flex: 1; height: 48px; background: #f9a8d4; color: #9b1a4b; border: none; border-radius: 50px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background 0.2s; white-space: nowrap; }
    #custom_add_to_cart_btn:hover { background: #f472b6; }
    #custom_add_to_cart_btn.loading { opacity: 0.7; pointer-events: none; }
    #custom_buy_now_btn { flex: 1; height: 48px; background: #6b0f3a; color: #fff; border: none; border-radius: 50px; font-size: 15px; font-weight: 600; cursor: pointer; transition: background 0.2s; white-space: nowrap; }
    #custom_buy_now_btn:hover { background: #4c0a28; }

    /* ── Mobile cart layout ──────────────────────────────────── */
    @media (max-width: 600px) {
        #custom-cart-row { flex-wrap: wrap; gap: 10px; }
        .custom-qty-wrap { width: auto; flex-shrink: 0; height: 46px; order: 1; }
        .custom-qty-wrap button { width: 36px; height: 46px; font-size: 18px; }
        #custom_qty_display { min-width: 30px; font-size: 14px; }
        #custom_add_to_cart_btn { flex: 1; min-width: 120px; height: 46px; font-size: 14px; order: 2; }
        #custom_buy_now_btn { width: 100%; flex: unset; height: 48px; font-size: 15px; order: 3; }
        body.single-product { padding-bottom: 80px; }
    }

    /* ── Sticky bottom bar (mobile only) ─────────────────────── */
    #sticky-cart-bar {
        display: none;
        position: fixed;
        bottom: 0;
        left: 0;
        right: 0;
        z-index: 99999;
        background: #fff;
        padding: 10px 16px;
        box-shadow: 0 -2px 12px rgba(0,0,0,0.12);
        gap: 10px;
        align-items: center;
        border-top: 1px solid #eee;
    }
    #sticky-cart-bar.visible { display: flex; }
    #sticky_add_to_cart_btn {
        flex: 1; height: 46px; background: #f9a8d4; color: #9b1a4b;
        border: none; border-radius: 50px; font-size: 14px; font-weight: 600;
        cursor: pointer; transition: background 0.2s; white-space: nowrap;
    }
    #sticky_add_to_cart_btn:hover { background: #f472b6; }
    #sticky_add_to_cart_btn.loading { opacity: 0.7; pointer-events: none; }
    #sticky_buy_now_btn {
        flex: 1; height: 46px; background: #6b0f3a; color: #fff;
        border: none; border-radius: 50px; font-size: 14px; font-weight: 600;
        cursor: pointer; transition: background 0.2s; white-space: nowrap;
    }
    #sticky_buy_now_btn:hover { background: #4c0a28; }
    @media (min-width: 601px) { #sticky-cart-bar { display: none !important; } }

    /* ── Delivery box ────────────────────────────────────────── */
    .coderockz-product-delivery-box {
        position: static !important; transform: none !important;
        top: auto !important; left: auto !important; z-index: auto !important;
        background: #fff8f0; border: 2px solid #c8a951;
        border-radius: 10px; padding: 20px; margin: 15px 0 20px 0;
    }
    .coderockz-product-delivery-box h4 { margin: 0 0 15px 0; font-size: 16px; font-weight: 700; color: #333; }
    .coderockz-product-delivery-box label { font-weight: 600; display: block; margin-bottom: 6px; color: #444; font-size: 14px; }
    .coderockz-date-wrapper { position: relative; width: 100%; display: block; }
    .coderockz-date-wrapper input[type="date"] {
        font-size: 16px !important; width: 100%; padding: 10px 12px;
        border: 1px solid #ddd; border-radius: 6px; background: #fff;
        box-sizing: border-box; -webkit-appearance: none; appearance: none;
        min-height: 44px; cursor: pointer; pointer-events: auto !important;
        position: relative; z-index: 1;
    }
    .coderockz-product-delivery-box select {
        font-size: 16px !important; width: 100%; padding: 10px 12px;
        border: 1px solid #ddd; border-radius: 6px; cursor: pointer;
        background: #fff; box-sizing: border-box;
        -webkit-appearance: none; appearance: none;
        min-height: 44px; pointer-events: auto !important;
    }
    .coderockz-product-delivery-box input[type="date"]:focus,
    .coderockz-product-delivery-box select:focus { border-color: #c8a951; outline: none; }
												  /* Sticky qty inside bottom bar */
.sticky-qty-wrap {
    height: 44px;
    flex-shrink: 0;
}
#sticky_qty_display {
    min-width: 32px;
    text-align: center;
    font-size: 14px;
    font-weight: 600;
    color: #111;
}
@media (max-width: 600px) {
    #sticky-cart-bar {
        gap: 10px;
    }
}

    /* ── Accordion focus fix ─────────────────────────────────── */
    .cpd-header:focus,
    .cpd-header:focus-visible { outline: none !important; box-shadow: none !important; }
	/* Popup overlay — must be in wp_head, NOT in the deferred script block */
#coderockz-popup-overlay {
    display: none;
    position: fixed;
    top: 0; left: 0;
    width: 100%; height: 100%;
    background: rgba(0,0,0,0.5);
    z-index: 999999;
}
#coderockz-popup-box {
    background: #fff;
    border-radius: 16px;
    padding: 32px 28px;
    max-width: 320px;
    width: 90%;
    text-align: center;
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
}
#coderockz-popup-icon { font-size: 40px; margin-bottom: 12px; }
#coderockz-popup-msg { font-size: 15px; color: #333; line-height: 1.6; margin-bottom: 20px; font-weight: 500; }
#coderockz-popup-close {
    background: #c8a951; color: #fff; border: none;
    border-radius: 8px; padding: 10px 28px;
    font-size: 14px; font-weight: 600;
    cursor: pointer; width: 100%;
}
#coderockz-popup-close:hover { background: #b8953f; }
