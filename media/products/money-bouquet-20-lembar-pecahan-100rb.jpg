	<form class="cart" action="https://gulmahal.in/flowers/luxurious-rose-bouquet/" method="post" enctype='multipart/form-data'>
		
    <div id="coderockz-popup-overlay">
        <div id="coderockz-popup-box">
            <div id="coderockz-popup-icon">📅</div>
            <div id="coderockz-popup-msg">Please select a Delivery Date & Time before proceeding.</div>
            <button id="coderockz-popup-close">OK, Got it</button>
        </div>
    </div>

    <div class="coderockz-product-delivery-box">
        <h4>🚚 Select Delivery Date & Time</h4>
        <input type="hidden" id="coderockz_current_time_mins" value="28" />
        <input type="hidden" id="coderockz_today_str" value="2026-06-01" />
        <p>
            <label>Delivery Date <span style="color:red">*</span></label>
            <div class="coderockz-date-wrapper">
                <input type="date"
                    id="coderockz_product_date"
                    name="coderockz_woo_delivery_date"
                    autocomplete="off"
                    min="2026-06-01"
                />
            </div>
        </p>
        <p>
            <label>Delivery Time <span style="color:red">*</span></label>
            <select name="coderockz_woo_delivery_time" id="coderockz_product_time">
                <option value="">-- Select Time Slot --</option>
                                    <option value="06:00 AM – 09:00 AM">06:00 AM – 09:00 AM</option>
                                    <option value="09:00 AM – 12:00 PM">09:00 AM – 12:00 PM</option>
                                    <option value="12:00 PM – 03:00 PM">12:00 PM – 03:00 PM</option>
                                    <option value="03:00 PM – 06:00 PM">03:00 PM – 06:00 PM</option>
                                    <option value="06:00 PM – 09:00 PM">06:00 PM – 09:00 PM</option>
                                    <option value="09:00 PM – 12:00 AM">09:00 PM – 12:00 AM</option>
                            </select>
        </p>
        <div id="coderockz-error-msg" style="display:none;color:red;font-size:14px;margin-top:5px;"></div>
    </div>

    <script>
    jQuery(document).ready(function($) {
        var offDays         = [];
        var currentTimeMins = parseInt($('#coderockz_current_time_mins').val()) || 0;
        var todayStr        = $('#coderockz_today_str').val();
        var bufferMins      = 30; // hide slots within 30 mins of current time

        // Set min date attribute
        $('#coderockz_product_date').attr('min', todayStr);

        // Full box tap opens date picker on mobile
        $(document).on('click', '.coderockz-date-wrapper', function() {
            var input = document.getElementById('coderockz_product_date');
            if (!input) return;
            try { input.showPicker(); } catch(e) { input.focus(); input.click(); }
        });

        // Popup close
        $(document).on('click', '#coderockz-popup-close', function(e) {
            e.preventDefault(); e.stopPropagation();
            $('#coderockz-popup-overlay').hide();
        });
        $(document).on('click', '#coderockz-popup-overlay', function(e) {
            if ($(e.target).is('#coderockz-popup-overlay')) $('#coderockz-popup-overlay').hide();
        });

        // Filter time slots — hide past slots + 30 min buffer for today
        function filterTimeSlots(selectedDate) {
            var $select   = $('#coderockz_product_time');
            var isToday   = (selectedDate === todayStr);
            var threshold = currentTimeMins + bufferMins; // current IST + 30 min buffer

            $select.find('option').each(function() {
                var val = $(this).val();
                if (!val) return;
                var slotStart = val.split('–')[0].trim();
                var timeParts = slotStart.match(/(\d+):(\d+)\s*(AM|PM)/i);
                if (!timeParts) return;
                var hours   = parseInt(timeParts[1]);
                var minutes = parseInt(timeParts[2]);
                var period  = timeParts[3].toUpperCase();
                if (period === 'PM' && hours !== 12) hours += 12;
                if (period === 'AM' && hours === 12) hours = 0;
                var slotStartMins = hours * 60 + minutes;

                // For today: hide slots that start within buffer window
                if (isToday && slotStartMins <= threshold) {
                    $(this).prop('disabled', true).hide();
                } else {
                    $(this).prop('disabled', false).show();
                }
            });

            // Reset selection if currently selected slot is now hidden
            if ($select.find('option:selected').prop('disabled')) $select.val('');

            // If no slots left for today, move to tomorrow
            var $available = $select.find('option:enabled').not(':first');
            if (isToday && $available.length === 0) {
                var tomorrow = new Date(selectedDate + 'T00:00:00');
                tomorrow.setDate(tomorrow.getDate() + 1);
                var nextDay = tomorrow.getFullYear() + '-'
                    + String(tomorrow.getMonth()+1).padStart(2,'0') + '-'
                    + String(tomorrow.getDate()).padStart(2,'0');
                $('#coderockz_product_date').val(nextDay);
                $('#coderockz-error-msg').text('⚠️ No slots available today. Date moved to tomorrow.').show();
                setTimeout(function() { $('#coderockz-error-msg').fadeOut(); }, 3500);
                filterTimeSlots(nextDay);
                return;
            }
        }

        // Date change handler
        $('#coderockz_product_date').on('input change', function() {
            var val = $(this).val();
            if (!val) return;

            // Strictly block past dates
            if (val < todayStr) {
                $(this).val('');
                $('#coderockz-error-msg').text('⚠️ Past dates are not available. Please select today or a future date.').show();
                setTimeout(function() { $('#coderockz-error-msg').fadeOut(); }, 3000);
                return;
            }

            // Block off days
            var day = new Date(val + 'T00:00:00').getDay();
            if (offDays.indexOf(day) !== -1) {
                $('#coderockz-error-msg').text('⚠️ Delivery not available on this day. Please select another date.').show();
                $(this).val(''); return;
            }

            $('#coderockz-error-msg').hide();
            filterTimeSlots(val);
        });

        // Run on page load — filter slots for today immediately
        filterTimeSlots(todayStr);
    });
    </script>

    
    
