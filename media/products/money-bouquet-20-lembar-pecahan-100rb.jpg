    /* Remove ALL blue highlight on click, focus, hover */
.cpd-header {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 18px;
    cursor: pointer;
    user-select: none;
    background: transparent;
    border: none;
    width: 100%;
    text-align: left;
    
    /* These three kill the blue */
    outline: none !important;
    -webkit-tap-highlight-color: transparent;
    -webkit-appearance: none;
}

.cpd-header:focus,
.cpd-header:focus-visible,
.cpd-header:focus-within,
.cpd-header:active,
.cpd-header:hover {
    outline: none !important;
    box-shadow: none !important;
    background: transparent !important;
    color: inherit !important;
}

/* Also prevent the whole item from going blue */
.cpd-item:focus-within {
    outline: none !important;
}

    .cpd-icon {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
