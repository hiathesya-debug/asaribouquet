<script id='merchantWidgetScript' src="https://www.gstatic.com/shopping/merchant/merchantwidget.js" defer></script>

<script>
  merchantWidgetScript.addEventListener('load', function () {
    // Don't load on thank you page (opt-in script handles it)
    if (window.location.href.indexOf('/checkout/order-received/') === -1) {
      merchantwidget.start({
         merchant_id: 5405934370,
         position: 'BOTTOM_RIGHT', // or 'BOTTOM_LEFT'
      });
    }
  });
</script>
            <div class="smooth-back-to-top-button btn-right-side" role="button" tabindex="0" aria-label="Back to top">
				                    <svg class="progress-circle" width="100%" height="100%" viewBox="-2 -2 104 104" aria-hidden="true">
													<path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"/>
						                    </svg>
				            </div>

			
            <script type="text/javascript" data-no-optimize="1">
                (function () {
                    var offset = 30;
                    var duration = 500;

                    function initButton() {
                        var buttonWrap = document.querySelector('.smooth-back-to-top-button');
                        if (!buttonWrap) return;

                        window.addEventListener('scroll', function () {
                            if (window.scrollY > offset) {
                                buttonWrap.classList.add('active-progress');
                            } else {
                                buttonWrap.classList.remove('active-progress');
                            }
                        });

                        buttonWrap.addEventListener('click', function (e) {
                            e.preventDefault();
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        });

                        buttonWrap.addEventListener('keydown', function (e) {
                            if (e.key !== 'Enter' && e.key !== ' ') return;
                            e.preventDefault();
                            window.scrollTo({ top: 0, behavior: 'smooth' });
                        });
                    }

                    if (document.readyState === 'loading') {
                        document.addEventListener('DOMContentLoaded', initButton);
                    } else {
                        initButton();
                    }
                })();
            </script>

			
    <div id="sticky-cart-bar">
    <div class="custom-qty-wrap sticky-qty-wrap">
        <button id="sticky_qty_minus" type="button">&#8722;</button>
        <span id="sticky_qty_display">01</span>
        <button id="sticky_qty_plus" type="button">&#43;</button>
    </div>

    <button id="sticky_add_to_cart_btn" type="button">Add to cart</button>
</div>

    <script>
    (function($) {
      'use strict';

      function buildPincodeUI() {
        return '<div id="custom-pincode-section">'
          + '<span class="pin-label">Use pincode to check delivery info.</span>'
          + '<div class="custom-pin-input-wrap">'
          +   '<span class="pin-icon"><svg viewBox="0 0 24 24" fill="#9b1a4b"><path d="M12 2C8.686 2 6 4.686 6 8c0 5.25 6 13 6 13s6-7.75 6-13c0-3.314-2.686-6-6-6zm0 8.5A2.5 2.5 0 1 1 12 5.5a2.5 2.5 0 0 1 0 5z"/></svg></span>'
          +   '<input type="text" id="custom_pin_code" maxlength="10" placeholder="Enter your pin code" autocomplete="postal-code" inputmode="numeric" />'
          +   '<button id="custom_check_pin" type="button">Check</button>'
          + '</div>'
          + '<div id="custom_pin_result"></div>'
          + '</div>';
      }

      function buildCartUI() {
        return '<div id="custom-order-note">'
          +   '<label for="custom_order_note_input">Order Note <span>(optional)</span></label>'
          +   '<textarea id="custom_order_note_input" name="custom_order_note" placeholder="Any special instructions, message on card, etc..."></textarea>'
          + '</div>'
          + '<div id="custom-cart-row">'
          +   '<div class="custom-qty-wrap">'
          +     '<button id="custom_qty_minus" type="button">&#8722;</button>'
          +     '<span id="custom_qty_display">01</span>'
          +     '<button id="custom_qty_plus" type="button">&#43;</button>'
          +   '</div>'
          +   '<button id="custom_add_to_cart_btn" type="button">Add to cart</button>'
          +   '<button id="custom_buy_now_btn" type="button">Buy now</button>'
          + '</div>';
      }

      function getWCQtyInput() {
        return $('form.cart input.qty, form.cart input[name="quantity"]').first();
      }
      function getCurrentQty() { return parseInt(getWCQtyInput().val()) || 1; }
      function updateQtyDisplay(qty) {
  qty = Math.max(1, Math.min(99, qty));
  var formatted = String(qty).padStart(2, '0');
  $('#custom_qty_display, #sticky_qty_display').text(formatted);
  getWCQtyInput().val(qty).trigger('change');
}
      function showPinResult(msg, type) {
        $('#custom_pin_result').text(msg).removeClass('success error').addClass(type || '');
      }

      function checkPincode() {
        var pin = $('#custom_pin_code').val().trim();
        if (!pin) { showPinResult('Please enter a pin code.', 'error'); return; }
        $('#custom_check_pin').addClass('loading').text('Checking...');
        $('#custom_pin_result').text('').removeClass('success error');
        $('#pin_code').val(pin);
        setTimeout(function() {
          $('#check_pin').trigger('click');
          waitForPinResult();
        }, 80);
      }

      function waitForPinResult() {
        var attempts = 0;
        var interval = setInterval(function() {
          var rawText = $('#pin_res').text().trim();
          attempts++;
          if (rawText || attempts >= 40) {
            clearInterval(interval);
            $('#custom_check_pin').removeClass('loading').text('Check');
            if (!rawText) { showPinResult('Could not check pincode. Try again.', 'error'); return; }
            var isSuccess = /available|serviceable|deliver|yes/i.test(rawText);
            showPinResult(rawText, isSuccess ? 'success' : 'error');
          }
        }, 100);
      }

      function doAddToCart(callback) {
        var $btn = $('form.cart .single_add_to_cart_button');
        if (!$btn.length) return;
        var note = $('#custom_order_note_input').val().trim();
        if (note) {
          if ($('#order_comments').length) {
            $('#order_comments').val(note);
          } else {
            if (!$('#custom_order_note_hidden').length) {
              $('form.cart').append('<input type="hidden" id="custom_order_note_hidden" name="order_comments" />');
            }
            $('#custom_order_note_hidden').val(note);
          }
        }
        $('#custom_add_to_cart_btn, #custom_buy_now_btn, #sticky_add_to_cart_btn, #sticky_buy_now_btn').addClass('loading');
        $btn.trigger('click');
        $(document.body).one('added_to_cart', function() {
          $('#custom_add_to_cart_btn, #custom_buy_now_btn, #sticky_add_to_cart_btn, #sticky_buy_now_btn').removeClass('loading');
          if (typeof callback === 'function') callback();
        });
        setTimeout(function() {
          $('#custom_add_to_cart_btn, #custom_buy_now_btn, #sticky_add_to_cart_btn, #sticky_buy_now_btn').removeClass('loading');
          if (typeof callback === 'function') callback();
        }, 3500);
      }

      function showDeliveryPopup(msg) {
        $('#coderockz-popup-msg').text(msg);
        $('#coderockz-popup-overlay').fadeIn(200);
        $('html,body').animate({ scrollTop: $('.coderockz-product-delivery-box').offset().top - 100 }, 400);
      }

      function validateAndAddToCart(callback) {
        var date = $('#coderockz_product_date').val();
        var time = $('#coderockz_product_time').val();
        if (!date) {
          showDeliveryPopup('📅 Please select a Delivery Date before adding to cart.');
          return false;
        }
        if (!time) {
          showDeliveryPopup('🕐 Please select a Delivery Time Slot before adding to cart.');
          return false;
        }
        doAddToCart(callback);
        return true;
      }

      function init() {
        $('#custom-pincode-section, #custom-cart-row, #custom-order-note').remove();
        var $deliveryBox = $('.coderockz-product-delivery-box').first();
        var $form        = $('form.cart').first();
        if ($deliveryBox.length) {
          $deliveryBox.before(buildPincodeUI());
          $deliveryBox.after(buildCartUI());
        } else {
          var $target = $('form.cart .single_add_to_cart_button').closest('p, div').last();
          if (!$target.length) $target = $form;
          $target.after(buildCartUI());
          $target.after(buildPincodeUI());
        }
        updateQtyDisplay(getCurrentQty());
      }

      function initStickyBar() {
    if (window.innerWidth > 600) return;

    var $cartRow   = $('#custom-cart-row');
    var $stickyBar = $('#sticky-cart-bar');

    function checkScroll() {
        if (!$cartRow.length) return;

        var cartBottom = $cartRow.offset().top + $cartRow.outerHeight();
        var scrollTop  = $(window).scrollTop();

        // Show sticky bar ONLY after user has scrolled past the cart row
        if (scrollTop > cartBottom) {
            $stickyBar.addClass('visible');
        } else {
            $stickyBar.removeClass('visible');
        }
    }

    $(window).off('scroll.stickybar').on('scroll.stickybar', checkScroll);
    checkScroll(); // run once on load
}

      function bindEvents() {
        $(document).on('click', '#custom_check_pin', checkPincode);
        $(document).on('keydown', '#custom_pin_code', function(e) {
          if (e.key === 'Enter') { e.preventDefault(); checkPincode(); }
        });
        // Main qty
$(document).on('click', '#custom_qty_minus', function() {
  updateQtyDisplay(getCurrentQty() - 1);
});
$(document).on('click', '#custom_qty_plus', function() {
  updateQtyDisplay(getCurrentQty() + 1);
});

// Sticky qty
$(document).on('click', '#sticky_qty_minus', function() {
  updateQtyDisplay(getCurrentQty() - 1);
});
$(document).on('click', '#sticky_qty_plus', function() {
  updateQtyDisplay(getCurrentQty() + 1);
});

        $(document).on('click', '#custom_add_to_cart_btn, #sticky_add_to_cart_btn', function(e) {
          e.preventDefault(); e.stopImmediatePropagation();
          validateAndAddToCart(null);
        });

        $(document).on('click', '#custom_buy_now_btn, #sticky_buy_now_btn', function(e) {
          e.preventDefault(); e.stopImmediatePropagation();
          validateAndAddToCart(function() {
            var $gokwik = $('.gokwik-checkout-btn, [class*="gokwik"], [id*="gokwik"], .gkwk-btn').first();
            if ($gokwik.length) {
              $gokwik.trigger('click');
            } else {
              window.location.href = 'https://gulmahal.in/checkout/';
            }
          });
        });

        $(document.body).on('woocommerce_variation_has_changed', function() {
          setTimeout(function() { init(); initStickyBar(); }, 100);
        });
      }

      $(document).ready(function() {
        init();
        bindEvents();
        initStickyBar();
      });

    })(jQuery);
    </script>
        <script>
    (function($) {
      'use strict';

      var productIcon  = '<svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" fill="#f9a8d4" opacity="0.4"/><path d="M7 8h10M7 12h10M7 16h6" stroke="#9b1a4b" stroke-width="1.8" stroke-linecap="round"/></svg>';
      var deliveryIcon = '<svg viewBox="0 0 24 24" fill="none"><rect x="1" y="10" width="15" height="10" rx="2" fill="#f9a8d4" opacity="0.5"/><path d="M16 13h3l3 4v3h-6V13z" fill="#9b1a4b" opacity="0.4"/><circle cx="5.5" cy="20.5" r="1.5" fill="#9b1a4b"/><circle cx="18.5" cy="20.5" r="1.5" fill="#9b1a4b"/></svg>';
      var infoIcon     = '<svg viewBox="0 0 24 24" fill="none"><rect x="2" y="7" width="10" height="10" rx="2" fill="#f9a8d4" opacity="0.5"/><rect x="12" y="3" width="10" height="10" rx="2" fill="#9b1a4b" opacity="0.3"/><rect x="12" y="14" width="10" height="7" rx="2" fill="#f9a8d4" opacity="0.5"/></svg>';
      var chevron      = '<div class="cpd-chevron"><svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"/></svg></div>';

      function makeItem(icon, label, contentHTML, isOpen) {
        return '<div class="cpd-item' + (isOpen ? ' open' : '') + '">'
          + '<button class="cpd-header" type="button">'
          +   '<span class="cpd-icon">' + icon + '</span>'
          +   '<span class="cpd-label">' + label + '</span>'
          +   chevron
          + '</button>'
          + '<div class="cpd-body"><div class="cpd-body-inner">' + contentHTML + '</div></div>'
          + '</div>';
      }

      function isHeading(el, keyword) {
        var text = $(el).text().replace(/\u00a0/g, ' ').trim().toUpperCase();
        var innerText = $(el).find('b, strong').text().replace(/\u00a0/g, ' ').trim().toUpperCase();
        return text === keyword || innerText === keyword || 
               text.indexOf(keyword) === 0 || innerText.indexOf(keyword) === 0;
      }

      function splitContent(descHTML) {
        var $temp = $('<div>').html(descHTML);
        var introNodes    = [];
        var productNodes  = [];
        var deliveryNodes = [];
        var currentSection = 'intro';

        $temp.children().each(function() {
          if (isHeading(this, 'PRODUCT INFO')) {
            currentSection = 'product';
            return;
          }
          if (isHeading(this, 'DELIVERY INFO')) {
            currentSection = 'delivery';
            return;
          }

          var outerHTML = this.outerHTML;
          if (!outerHTML) return;

          if (currentSection === 'intro')         introNodes.push(outerHTML);
          else if (currentSection === 'product')  productNodes.push(outerHTML);
          else if (currentSection === 'delivery') deliveryNodes.push(outerHTML);
        });

        return {
          intro:    introNodes.join('').trim(),
          product:  productNodes.join('').trim(),
          delivery: deliveryNodes.join('').trim()
        };
      }

      function init() {
        if ($('#custom-product-details').length) return;

        var descHTML = '';
        var addHTML  = '';

        var $elWidget   = $('[data-widget_type="woocommerce-product-content.default"] .elementor-widget-container').first();
        var $directDesc = $('.woocommerce-product-details__short-description').first();
        var $tabDesc    = $('#tab-description').first();

        if ($elWidget.length && $elWidget.text().trim().length > 10) {
            var $clone = $elWidget.clone();
            $clone.find('h2, .wc-tabs, nav.woocommerce-tabs').remove();
            descHTML = $clone.html().trim();
        } else if ($directDesc.length && $directDesc.text().trim().length > 10) {
            descHTML = $directDesc.html().trim();
        } else if ($tabDesc.length && $tabDesc.text().trim().length > 10) {
            var $c = $tabDesc.clone();
            $c.find('h2').remove();
            descHTML = $c.html().trim();
        }

        if (!descHTML) {
          var $panel = $('#tab-description, .woocommerce-Tabs-panel--description').first();
          if ($panel.length) {
            var $c = $panel.clone();
            $c.find('h2').remove();
            descHTML = $c.html().trim();
          }
        }

        var $addPanel = $('#tab-additional_information, .woocommerce-Tabs-panel--additional_information').first();
        if ($addPanel.length) {
          var $ac = $addPanel.clone();
          $ac.find('h2').remove();
          addHTML = $ac.html().trim();
        }

        if (!descHTML && !addHTML) return;

        var split        = splitContent(descHTML);
        var introHTML    = split.intro;
        var productHTML  = split.product;
        var deliveryHTML = split.delivery;

        // Build accordion — no title, no emojis, first item closed by default
        var html = '<div id="custom-product-details">';

        if (introHTML) {
          html += '<div class="cpd-intro">' + introHTML + '</div>';
        }

        if (productHTML) {
          html += makeItem(productIcon, 'Product Info', productHTML, false);
        }

        if (deliveryHTML) {
          html += makeItem(deliveryIcon, 'Delivery Info', deliveryHTML, false);
        }

        if (addHTML) {
          html += makeItem(infoIcon, 'Additional Info', addHTML, false);
        }

        html += '</div>';

        var $anchor = $('[data-widget_type="woocommerce-product-content.default"]').first();
        if (!$anchor.length) $anchor = $('[data-widget_type="woocommerce-product-price.default"]').first();
        if (!$anchor.length) $anchor = $('form.cart').first();
        if (!$anchor.length) $anchor = $('.summary').first();
        if (!$anchor.length) return;

        $anchor.after(html);

        $(document).off('click.cpd').on('click.cpd', '.cpd-header', function() {
          var $item  = $(this).closest('.cpd-item');
          var wasOpen = $item.hasClass('open');
          $('.cpd-item').removeClass('open');
          if (!wasOpen) $item.addClass('open');
        });
      }

      $(document).ready(function() {
        init();
        setTimeout(init, 1000);
      });

    })(jQuery);
    </script>
    
